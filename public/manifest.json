{
  "manifest_version": 3,
  "name": "FACEIT CheckMate",
  "version": "1.0",
  "description": "A browser extension scaffolded with TypeScript and Bun.",
  "permissions": ["cookies", "storage", "notifications"],
  "host_permissions": [
    "https://*.faceit.com/*",
    "https://www.steamcommunity.com/profiles/*",
    "https://www.steamcommunity.com/id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.faceit.com/*"],
      "js": ["content.js"]
    }
  ]
}
