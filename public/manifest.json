{
  "manifest_version": 3,
  "name": "FACEIT CheckMate",
  "version": "1.2",
  "description": "Find matches with banned FACEIT players instantly. Trace cheaters, see shared match history, and get your Elo context back.",

  "permissions": ["cookies"],
  "host_permissions": [
    "https://*.faceit.com/*",
    "https://www.steamcommunity.com/profiles/*",
    "https://www.steamcommunity.com/id/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.faceit.com/*"],
      "js": ["content.js"]
    }
  ]
}
